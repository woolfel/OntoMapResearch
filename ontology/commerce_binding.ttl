bigriver:OrderLine__unitPrice
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bigriver:OrderLine ;
    cb:bindsProperty cc:unitPrice ;
    cb:sourceExpression "CASE WHEN ITM_PRICE_CCY = (SELECT c.SC_DISPLAY_CCY FROM SHOPPING_CART c WHERE c.SC_UUID = ITEM.ITM_SC_UUID) THEN ITM_OFFER_PRICE END" ;
    cb:valueFormat cb:MoneyMajor ;
    cb:toCoreExpression "CASE WHEN ITM_PRICE_CCY = (SELECT c.SC_DISPLAY_CCY FROM SHOPPING_CART c WHERE c.SC_UUID = ITEM.ITM_SC_UUID) THEN ITM_OFFER_PRICE END" ;
