    cb:usesColumn bobsuncle:column_cart_item__sku ;
    cb:targetBinding bobsuncle:OrderLine ;
    cb:joinExpressions ( "\"cart_no\"" "(SELECT m.line_seq FROM cart_item m WHERE m.cart_no = cart_item.cart_no AND m.ext_warr_sku = cart_item.sku)" ) .

bobsuncle:AppliedDiscount
    a owl:NamedIndividual , cb:ConceptBinding ;
    cb:inSource bobsuncle:source ;
    cb:bindsClass cc:AppliedDiscount ;
    rdfs:label "BobsUncle AppliedDiscount"@en ;
    cb:keyExpressions ( "\"cart_no\"" "\"line_seq\"" ) ;
    cb:fromTable bobsuncle:table_cart_item ;
    cb:keyColumn bobsuncle:column_cart_item__cart_no ;
    cb:keyColumn bobsuncle:column_cart_item__line_seq ;
    cb:rowFilter "disc_cents <> 0 AND qty > 0" ;
    rdfs:comment "Discounts are free-text reasons; matching them to a promotion is fuzzy."@en ;
    cb:usesColumn bobsuncle:column_cart_item__cart_no ;
    cb:usesColumn bobsuncle:column_cart_item__disc_cents ;
    cb:usesColumn bobsuncle:column_cart_item__disc_reason ;
    cb:usesColumn bobsuncle:column_cart_item__line_seq ;
    cb:usesColumn bobsuncle:column_cart_item__qty ;
    cb:usesColumn bobsuncle:column_promotion__promo_cd ;
    cb:usesColumn bobsuncle:column_promotion__promo_id .

bobsuncle:AppliedDiscount__discountAmount
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:AppliedDiscount ;
    cb:bindsProperty cc:discountAmount ;
    cb:sourceColumn bobsuncle:column_cart_item__disc_cents ;
    cb:sourceExpression "disc_cents" ;
    cb:valueFormat cb:MoneyMinor ;
    cb:toCoreExpression "\"disc_cents\" / 100.0" ;
    cb:usesColumn bobsuncle:column_cart_item__disc_cents .

bobsuncle:AppliedDiscount__discountReason
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:AppliedDiscount ;
    cb:bindsProperty cc:discountReason ;
    cb:sourceColumn bobsuncle:column_cart_item__disc_reason ;
    cb:sourceExpression "disc_reason" ;
    cb:valueFormat cb:TrimmedText ;
    cb:toCoreExpression "nullif(trim(\"disc_reason\"), '')" ;
    cb:usesColumn bobsuncle:column_cart_item__disc_reason .

bobsuncle:AppliedDiscount__appliedToLine
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding bobsuncle:AppliedDiscount ;
    cb:bindsProperty cc:appliedToLine ;
    cb:usesColumn bobsuncle:column_cart_item__cart_no ;
    cb:usesColumn bobsuncle:column_cart_item__line_seq ;
    cb:targetBinding bobsuncle:OrderLine ;
    cb:joinExpressions ( "\"cart_no\"" "\"line_seq\"" ) .

bobsuncle:AppliedDiscount__appliedToOrder
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding bobsuncle:AppliedDiscount ;
    cb:bindsProperty cc:appliedToOrder ;
    cb:usesColumn bobsuncle:column_cart_item__cart_no ;
    cb:targetBinding bobsuncle:Order ;
    cb:joinExpressions ( "\"cart_no\"" ) .

bobsuncle:AppliedDiscount__fromPromotion
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding bobsuncle:AppliedDiscount ;
    cb:bindsProperty cc:fromPromotion ;
    cb:usesColumn bobsuncle:column_cart_item__disc_reason ;
    cb:usesColumn bobsuncle:column_promotion__promo_cd ;
    cb:usesColumn bobsuncle:column_promotion__promo_id ;
    cb:targetBinding bobsuncle:Promotion ;
    cb:joinExpressions ( "(SELECT min(p.promo_id) FROM promotion p WHERE p.promo_cd IS NOT NULL AND upper(cart_item.disc_reason) LIKE '%' || upper(p.promo_cd) || '%')" ) .

