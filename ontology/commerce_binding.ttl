bobsuncle:Order__orderStatus
    a owl:NamedIndividual , cb:ValueBinding ;
    cb:ofConceptBinding bobsuncle:Order ;
    cb:bindsProperty cc:orderStatus ;
    cb:sourceColumn bobsuncle:column_cart__cart_stat ;
    cb:sourceExpression "cart_stat" ;
    cb:valueFormat cb:Code ;
    cb:usesColumn bobsuncle:column_cart__cart_stat ;
    cb:valueMap [ a cb:ValueMap ; cb:sourceValue "O" ; cb:targetIndividual cc:OrderStatus_CART ] , [ a cb:ValueMap ; cb:sourceValue "C" ; cb:targetIndividual cc:OrderStatus_PLACED ] , [ a cb:ValueMap ; cb:sourceValue "A" ; cb:targetIndividual cc:OrderStatus_ABANDONED ] , [ a cb:ValueMap ; cb:sourceValue "X" ; cb:targetIndividual cc:OrderStatus_CANCELLED ] .

bobsuncle:Order__salesChannel
    a owl:NamedIndividual , cb:ValueBinding ;
    cb:ofConceptBinding bobsuncle:Order ;
