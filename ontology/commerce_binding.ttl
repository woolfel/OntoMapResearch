bobsuncle:ReturnLine__returnedProduct
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding bobsuncle:ReturnLine ;
    cb:bindsProperty cc:returnedProduct ;
    cb:usesColumn bobsuncle:column_cart_item__sku ;
    cb:targetBinding bobsuncle:Product ;
    cb:joinExpressions ( "\"sku\"" ) .

bobsuncle:ReturnLine__returnReason
    a owl:NamedIndividual , cb:ValueBinding ;
    cb:ofConceptBinding bobsuncle:ReturnLine ;
    cb:bindsProperty cc:returnReason ;
    cb:constantIndividual cc:ReturnReason_UNSPECIFIED .

bobsuncle:ReturnLine__requestedResolution
    a owl:NamedIndividual , cb:ValueBinding ;
    cb:ofConceptBinding bobsuncle:ReturnLine ;
    cb:bindsProperty cc:requestedResolution ;
    cb:constantIndividual cc:ReturnResolution_REFUND .

bobsuncle:Refund
    a owl:NamedIndividual , cb:ConceptBinding ;
    cb:inSource bobsuncle:source ;
    cb:bindsClass cc:Refund ;
    rdfs:label "BobsUncle Refund"@en ;
    cb:keyExpressions ( "\"cart_no\"" ) ;
    cb:fromTable bobsuncle:table_cart ;
    cb:keyColumn bobsuncle:column_cart__cart_no ;
    cb:rowFilter "total_cents < 0" ;
    rdfs:comment "Negative cart total = cash refunded."@en ;
    cb:usesColumn bobsuncle:column_cart__cart_no ;
    cb:usesColumn bobsuncle:column_cart__checkout_ts ;
    cb:usesColumn bobsuncle:column_cart__total_cents .

