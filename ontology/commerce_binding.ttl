    a owl:NamedIndividual , cb:SourceSystem ;
    rdfs:label "BigRiver"@en ;
    cb:sourceCode "bigriver" ;
    cb:dialect "SQLite 3" ;
    cb:schemaFile "big_river.sql" ;
    cb:sampleDatabase "big_river/big_river.db" ;
    rdfs:comment "Marketplace with third-party stores. UUID keys, multi-currency, percent as fractions, timestamps UTC text, brand as free text, attributes as key/value tags."@en .

