bobsuncle:Promotion__isActive
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Promotion ;
    cb:bindsProperty cc:isActive ;
    cb:sourceColumn bobsuncle:column_promotion__active_flg ;
    cb:sourceExpression "active_flg" ;
    cb:valueFormat cb:FlagYN ;
    cb:toCoreExpression "CASE upper(\"active_flg\") WHEN 'Y' THEN 1 WHEN 'N' THEN 0 END" ;
    cb:usesColumn bobsuncle:column_promotion__active_flg .

bobsuncle:Promotion__isStackable
    a owl:NamedIndividual , cb:AttributeBinding ;
