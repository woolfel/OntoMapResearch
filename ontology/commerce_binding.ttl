bobsuncle:Customer
    a owl:NamedIndividual , cb:ConceptBinding ;
    cb:inSource bobsuncle:source ;
    cb:bindsClass cc:Customer ;
    rdfs:label "BobsUncle Customer"@en ;
    cb:keyExpressions ( "\"cust_ref\"" ) ;
    cb:fromTable bobsuncle:table_cart ;
    cb:keyColumn bobsuncle:column_cart__cust_ref ;
    cb:rowFilter "cust_ref IS NOT NULL" ;
    rdfs:comment "cust_ref holds a loyalty number or an email address."@en ;
    cb:usesColumn bobsuncle:column_cart__cust_ref .

bobsuncle:Customer__customerNumber
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Customer ;
    cb:bindsProperty cc:customerNumber ;
    cb:sourceColumn bobsuncle:column_cart__cust_ref ;
    cb:sourceExpression "cust_ref" ;
    cb:valueFormat cb:Text ;
    cb:toCoreExpression "\"cust_ref\"" ;
    cb:usesColumn bobsuncle:column_cart__cust_ref .

bobsuncle:Customer__loyaltyNumber
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Customer ;
    cb:bindsProperty cc:loyaltyNumber ;
    cb:sourceExpression "CASE WHEN cust_ref NOT LIKE '%@%' THEN cust_ref END" ;
    cb:valueFormat cb:Text ;
    cb:toCoreExpression "CASE WHEN cust_ref NOT LIKE '%@%' THEN cust_ref END" ;
    cb:usesColumn bobsuncle:column_cart__cust_ref .

bobsuncle:Customer__email
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Customer ;
    cb:bindsProperty cc:email ;
    cb:sourceExpression "CASE WHEN cust_ref LIKE '%@%' THEN cust_ref END" ;
    cb:valueFormat cb:Email ;
    cb:toCoreExpression "lower(trim(CASE WHEN cust_ref LIKE '%@%' THEN cust_ref END))" ;
    cb:usesColumn bobsuncle:column_cart__cust_ref .

bobsuncle:ShipZip
    a owl:NamedIndividual , cb:ConceptBinding ;
    cb:inSource bobsuncle:source ;
    cb:bindsClass cc:Address ;
    rdfs:label "BobsUncle ShipZip"@en ;
    cb:keyExpressions ( "\"cart_no\"" ) ;
    cb:fromTable bobsuncle:table_cart ;
    cb:keyColumn bobsuncle:column_cart__cart_no ;
    cb:rowFilter "ship_zip IS NOT NULL" ;
    rdfs:comment "Only the US ZIP code of web orders is known."@en ;
    cb:usesColumn bobsuncle:column_cart__cart_no ;
    cb:usesColumn bobsuncle:column_cart__ship_zip .

bobsuncle:ShipZip__postalCode
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:ShipZip ;
    cb:bindsProperty cc:postalCode ;
    cb:sourceColumn bobsuncle:column_cart__ship_zip ;
    cb:sourceExpression "ship_zip" ;
    cb:valueFormat cb:TrimmedText ;
    cb:toCoreExpression "nullif(trim(\"ship_zip\"), '')" ;
    cb:usesColumn bobsuncle:column_cart__ship_zip .

bobsuncle:ShipZip__addressCountry
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding bobsuncle:ShipZip ;
    cb:bindsProperty cc:addressCountry ;
    cb:matchOnProperty cc:countryCode ;
    cb:constantValue "US" .

bobsuncle:Order
    a owl:NamedIndividual , cb:ConceptBinding ;
    cb:inSource bobsuncle:source ;
    cb:bindsClass cc:Order ;
    rdfs:label "BobsUncle Order"@en ;
    cb:keyExpressions ( "\"cart_no\"" ) ;
