    cb:sourceExpression "-qty" ;
    cb:valueFormat cb:Integer ;
    cb:toCoreExpression "CAST(-qty AS INTEGER)" ;
    cb:usesColumn bobsuncle:column_cart_item__qty .

bobsuncle:ReturnLine__inReturn
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding bobsuncle:ReturnLine ;
