    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding acme:LineDiscount ;
    cb:bindsProperty cc:appliedToOrder ;
    cb:usesColumn acme:column_OrderItem__OrderId ;
    cb:targetBinding acme:Order ;
    cb:joinExpressions ( "\"OrderId\"" ) .

acme:LineDiscount__fromPromotion
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding acme:LineDiscount ;
    cb:bindsProperty cc:fromPromotion ;
    cb:usesColumn acme:column_Order__OrderId ;
    cb:usesColumn acme:column_Order__PromotionId ;
    cb:usesColumn acme:column_OrderItem__OrderId ;
    cb:targetBinding acme:Promotion ;
    cb:joinExpressions ( "(SELECT o.PromotionId FROM \"Order\" o WHERE o.OrderId = OrderItem.OrderId)" ) .

acme:OrderDiscount
    a owl:NamedIndividual , cb:ConceptBinding ;
    cb:inSource acme:source ;
    cb:bindsClass cc:AppliedDiscount ;
    rdfs:label "AcmeShopping OrderDiscount"@en ;
    cb:keyExpressions ( "\"OrderId\"" ) ;
    cb:fromTable acme:table_Order ;
    cb:keyColumn acme:column_Order__OrderId ;
    cb:rowFilter "PromotionId IS NOT NULL AND DiscountTotal > (SELECT coalesce(sum(i.LineDiscount), 0) FROM OrderItem i WHERE i.OrderId = \"Order\".OrderId)" ;
    rdfs:comment "Order-level discount = order discount total minus line discounts."@en ;
    cb:usesColumn acme:column_Order__DiscountTotal ;
    cb:usesColumn acme:column_Order__OrderId ;
    cb:usesColumn acme:column_Order__PromotionId ;
    cb:usesColumn acme:column_OrderItem__LineDiscount ;
    cb:usesColumn acme:column_OrderItem__OrderId .

acme:OrderDiscount__discountAmount
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding acme:OrderDiscount ;
    cb:bindsProperty cc:discountAmount ;
    cb:sourceExpression "DiscountTotal - (SELECT coalesce(sum(i.LineDiscount), 0) FROM OrderItem i WHERE i.OrderId = \"Order\".OrderId)" ;
    cb:valueFormat cb:MoneyMajor ;
    cb:toCoreExpression "DiscountTotal - (SELECT coalesce(sum(i.LineDiscount), 0) FROM OrderItem i WHERE i.OrderId = \"Order\".OrderId)" ;
    cb:usesColumn acme:column_Order__DiscountTotal ;
    cb:usesColumn acme:column_Order__OrderId ;
    cb:usesColumn acme:column_OrderItem__LineDiscount ;
    cb:usesColumn acme:column_OrderItem__OrderId .

acme:OrderDiscount__appliedToOrder
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding acme:OrderDiscount ;
    cb:bindsProperty cc:appliedToOrder ;
    cb:usesColumn acme:column_Order__OrderId ;
    cb:targetBinding acme:Order ;
    cb:joinExpressions ( "\"OrderId\"" ) .

acme:OrderDiscount__fromPromotion
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding acme:OrderDiscount ;
    cb:bindsProperty cc:fromPromotion ;
    cb:usesColumn acme:column_Order__PromotionId ;
    cb:targetBinding acme:Promotion ;
    cb:joinExpressions ( "\"PromotionId\"" ) .


