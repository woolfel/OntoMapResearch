acme:LineDiscount
    a owl:NamedIndividual , cb:ConceptBinding ;
    cb:inSource acme:source ;
    cb:bindsClass cc:AppliedDiscount ;
    rdfs:label "AcmeShopping LineDiscount"@en ;
    cb:keyExpressions ( "\"OrderItemId\"" ) ;
    cb:fromTable acme:table_OrderItem ;
    cb:keyColumn acme:column_OrderItem__OrderItemId ;
    cb:rowFilter "LineDiscount > 0" ;
    rdfs:comment "Line discount; its promotion is the order's PromotionId."@en ;
    cb:usesColumn acme:column_Order__OrderId ;
    cb:usesColumn acme:column_Order__PromotionId ;
    cb:usesColumn acme:column_OrderItem__LineDiscount ;
    cb:usesColumn acme:column_OrderItem__OrderId ;
    cb:usesColumn acme:column_OrderItem__OrderItemId .

