canonical:source
    a owl:NamedIndividual , cb:SourceSystem ;
    rdfs:label "Canonical E-Commerce Model"@en ;
    cb:sourceCode "canonical" ;
    cb:dialect "SQLite 3" ;
    cb:schemaFile "canonical_ecommerce.sql" ;
    rdfs:comment "The normalized integration model. Money in INTEGER minor units, percent as fractions, ISO-8601 UTC timestamps, codes equal to the core skos:notation values."@en .

