bobsuncle:Refund__refundedAt
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Refund ;
    cb:bindsProperty cc:refundedAt ;
    cb:sourceColumn bobsuncle:column_cart__checkout_ts ;
    cb:sourceExpression "checkout_ts" ;
    cb:valueFormat cb:TimestampLocalUSCentral ;
    cb:toCoreExpression "/* America/Chicago -> UTC */ \"checkout_ts\"" ;
    cb:usesColumn bobsuncle:column_cart__checkout_ts .

bobsuncle:Refund__forReturn
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding bobsuncle:Refund ;
    cb:bindsProperty cc:forReturn ;
    cb:usesColumn bobsuncle:column_cart__cart_no ;
    cb:targetBinding bobsuncle:ReturnAuthorization ;
    cb:joinExpressions ( "\"cart_no\"" ) .

bobsuncle:Refund__hasCurrency
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding bobsuncle:Refund ;
    cb:bindsProperty cc:hasCurrency ;
    cb:matchOnProperty cc:currencyCode ;
    cb:constantValue "USD" .

