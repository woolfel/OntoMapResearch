    cb:valueFormat cb:TimestampLocalUSCentral ;
    cb:toCoreExpression "/* America/Chicago -> UTC */ \"created_ts\"" ;
    cb:usesColumn bobsuncle:column_cart__created_ts .

bobsuncle:ReturnAuthorization__returnClosedAt
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:ReturnAuthorization ;
    cb:bindsProperty cc:returnClosedAt ;
    cb:sourceColumn bobsuncle:column_cart__checkout_ts ;
