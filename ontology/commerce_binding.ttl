bobsuncle:source
    a owl:NamedIndividual , cb:SourceSystem ;
    rdfs:label "BobsUncle"@en ;
    cb:sourceCode "bobsuncle" ;
    cb:dialect "SQLite 3" ;
    cb:schemaFile "bobs_uncle.sql" ;
    cb:sampleDatabase "bobs_uncle/bobs_uncle.db" ;
    rdfs:comment "Convenience-store franchise. Wide legacy tables, money in INTEGER cents, Y/N flags, 'YYYYMMDD' text dates, US/Central local timestamps, returns as negative quantities."@en .

