bobsuncle:Promotion__hasCurrency
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding bobsuncle:Promotion ;
    cb:bindsProperty cc:hasCurrency ;
    cb:matchOnProperty cc:currencyCode ;
    cb:constantValue "USD" .

bobsuncle:Promotion__promotionScope
    a owl:NamedIndividual , cb:ValueBinding ;
    cb:ofConceptBinding bobsuncle:Promotion ;
    cb:bindsProperty cc:promotionScope ;
    cb:sourceColumn bobsuncle:column_promotion__scope ;
    cb:sourceExpression "scope" ;
    cb:valueFormat cb:Code ;
    cb:usesColumn bobsuncle:column_promotion__scope ;
    cb:valueMap [ a cb:ValueMap ; cb:sourceValue "SITEWIDE" ; cb:targetIndividual cc:PromotionScope_SITEWIDE ] , [ a cb:ValueMap ; cb:sourceValue "PRODUCT" ; cb:targetIndividual cc:PromotionScope_ITEM ] , [ a cb:ValueMap ; cb:sourceValue "DEPT" ; cb:targetIndividual cc:PromotionScope_ITEM ] , [ a cb:ValueMap ; cb:sourceValue "CART" ; cb:targetIndividual cc:PromotionScope_ORDER ] .

bobsuncle:Promotion__fundedBy
    a owl:NamedIndividual , cb:ValueBinding ;
    cb:ofConceptBinding bobsuncle:Promotion ;
    cb:bindsProperty cc:fundedBy ;
    cb:sourceColumn bobsuncle:column_promotion__funded_by ;
    cb:sourceExpression "funded_by" ;
    cb:valueFormat cb:Code ;
    cb:usesColumn bobsuncle:column_promotion__funded_by ;
    cb:valueMap [ a cb:ValueMap ; cb:sourceValue "RETAILER" ; cb:targetIndividual cc:FundingSource_PLATFORM ] , [ a cb:ValueMap ; cb:sourceValue "MFR" ; cb:targetIndividual cc:FundingSource_MANUFACTURER ] .

bobsuncle:ReturnAuthorization
    a owl:NamedIndividual , cb:ConceptBinding ;
    cb:inSource bobsuncle:source ;
    cb:bindsClass cc:ReturnAuthorization ;
    rdfs:label "BobsUncle ReturnAuthorization"@en ;
    cb:keyExpressions ( "\"cart_no\"" ) ;
    cb:fromTable bobsuncle:table_cart ;
    cb:keyColumn bobsuncle:column_cart__cart_no ;
    cb:rowFilter "EXISTS (SELECT 1 FROM cart_item i WHERE i.cart_no = cart.cart_no AND i.qty < 0)" ;
    rdfs:comment "No RMA table: a cart with negative-quantity lines is an in-store return."@en ;
    cb:usesColumn bobsuncle:column_cart__cart_no ;
    cb:usesColumn bobsuncle:column_cart__checkout_ts ;
    cb:usesColumn bobsuncle:column_cart__created_ts ;
    cb:usesColumn bobsuncle:column_cart__cust_ref ;
    cb:usesColumn bobsuncle:column_cart_item__cart_no ;
    cb:usesColumn bobsuncle:column_cart_item__qty .

bobsuncle:ReturnAuthorization__rmaNumber
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:ReturnAuthorization ;
    cb:bindsProperty cc:rmaNumber ;
    cb:sourceColumn bobsuncle:column_cart__cart_no ;
    cb:sourceExpression "cart_no" ;
    cb:valueFormat cb:Text ;
    cb:toCoreExpression "\"cart_no\"" ;
    cb:usesColumn bobsuncle:column_cart__cart_no .

