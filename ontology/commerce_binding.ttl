    cb:usesColumn bobsuncle:column_cart__cust_ref .

bobsuncle:Order__createdAt
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Order ;
    cb:bindsProperty cc:createdAt ;
    cb:sourceColumn bobsuncle:column_cart__created_ts ;
    cb:sourceExpression "created_ts" ;
    cb:valueFormat cb:TimestampLocalUSCentral ;
    cb:toCoreExpression "/* America/Chicago -> UTC */ \"created_ts\"" ;
    cb:usesColumn bobsuncle:column_cart__created_ts .

bobsuncle:Order__placedAt
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Order ;
    cb:bindsProperty cc:placedAt ;
    cb:sourceColumn bobsuncle:column_cart__checkout_ts ;
    cb:sourceExpression "checkout_ts" ;
    cb:valueFormat cb:TimestampLocalUSCentral ;
    cb:toCoreExpression "/* America/Chicago -> UTC */ \"checkout_ts\"" ;
    cb:usesColumn bobsuncle:column_cart__checkout_ts .

bobsuncle:Order__subtotalAmount
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Order ;
    cb:bindsProperty cc:subtotalAmount ;
    cb:sourceExpression "(SELECT sum(i.qty * i.unit_price_cents) FROM cart_item i WHERE i.cart_no = cart.cart_no AND i.removed_flg = 'N')" ;
    cb:valueFormat cb:MoneyMinor ;
    cb:toCoreExpression "(SELECT sum(i.qty * i.unit_price_cents) FROM cart_item i WHERE i.cart_no = cart.cart_no AND i.removed_flg = 'N') / 100.0" ;
    cb:usesColumn bobsuncle:column_cart__cart_no ;
    cb:usesColumn bobsuncle:column_cart_item__cart_no ;
    cb:usesColumn bobsuncle:column_cart_item__qty ;
    cb:usesColumn bobsuncle:column_cart_item__removed_flg ;
    cb:usesColumn bobsuncle:column_cart_item__unit_price_cents .

bobsuncle:Order__discountTotal
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Order ;
    cb:bindsProperty cc:discountTotal ;
    cb:sourceExpression "(SELECT sum(i.disc_cents) FROM cart_item i WHERE i.cart_no = cart.cart_no AND i.removed_flg = 'N')" ;
    cb:valueFormat cb:MoneyMinor ;
    cb:toCoreExpression "(SELECT sum(i.disc_cents) FROM cart_item i WHERE i.cart_no = cart.cart_no AND i.removed_flg = 'N') / 100.0" ;
    cb:usesColumn bobsuncle:column_cart__cart_no ;
    cb:usesColumn bobsuncle:column_cart_item__cart_no ;
    cb:usesColumn bobsuncle:column_cart_item__disc_cents ;
    cb:usesColumn bobsuncle:column_cart_item__removed_flg .

bobsuncle:Order__taxTotal
    a owl:NamedIndividual , cb:AttributeBinding ;
