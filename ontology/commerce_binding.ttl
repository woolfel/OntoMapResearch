bobsuncle:Seller
    a owl:NamedIndividual , cb:ConceptBinding ;
    cb:inSource bobsuncle:source ;
    cb:bindsClass cc:Seller ;
    rdfs:label "BobsUncle Seller"@en ;
    cb:keyExpressions ( "'bobs-uncle'" ) ;
    cb:isVirtual true ;
    rdfs:comment "BobsUncle is its own (only) seller."@en .

bobsuncle:Seller__sellerHandle
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Seller ;
    cb:bindsProperty cc:sellerHandle ;
    cb:constantValue "bobs-uncle" .

bobsuncle:Seller__sellerName
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Seller ;
    cb:bindsProperty cc:sellerName ;
    cb:constantValue "Bob's Uncle" .

bobsuncle:Seller__isFirstParty
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Seller ;
    cb:bindsProperty cc:isFirstParty ;
    cb:constantValue true .

bobsuncle:Manufacturer
    a owl:NamedIndividual , cb:ConceptBinding ;
    cb:inSource bobsuncle:source ;
    cb:bindsClass cc:Manufacturer ;
    rdfs:label "BobsUncle Manufacturer"@en ;
    cb:keyExpressions ( "\"mfr_cd\"" ) ;
    cb:fromTable bobsuncle:table_brand ;
    cb:keyColumn bobsuncle:column_brand__mfr_cd ;
    rdfs:comment "brand has one row per manufacturer + model, so manufacturer values repeat and mfr_nm is spelled inconsistently between rows."@en ;
    cb:usesColumn bobsuncle:column_brand__mfr_cd ;
    cb:usesColumn bobsuncle:column_brand__mfr_contact_email ;
    cb:usesColumn bobsuncle:column_brand__mfr_contact_phone ;
    cb:usesColumn bobsuncle:column_brand__mfr_hq_country ;
    cb:usesColumn bobsuncle:column_brand__mfr_nm ;
    cb:usesColumn bobsuncle:column_brand__mfr_website_url .

bobsuncle:Manufacturer__manufacturerCode
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Manufacturer ;
    cb:bindsProperty cc:manufacturerCode ;
    cb:sourceColumn bobsuncle:column_brand__mfr_cd ;
    cb:sourceExpression "mfr_cd" ;
    cb:valueFormat cb:Text ;
    cb:toCoreExpression "\"mfr_cd\"" ;
    cb:usesColumn bobsuncle:column_brand__mfr_cd .

bobsuncle:Manufacturer__manufacturerName
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Manufacturer ;
    cb:bindsProperty cc:manufacturerName ;
    cb:sourceColumn bobsuncle:column_brand__mfr_nm ;
    cb:sourceExpression "mfr_nm" ;
    cb:valueFormat cb:BrandFreeText ;
    cb:toCoreExpression "trim(\"mfr_nm\")" ;
    cb:usesColumn bobsuncle:column_brand__mfr_nm .

bobsuncle:Manufacturer__phone
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Manufacturer ;
    cb:bindsProperty cc:phone ;
    cb:sourceColumn bobsuncle:column_brand__mfr_contact_phone ;
    cb:sourceExpression "mfr_contact_phone" ;
    cb:valueFormat cb:Text ;
    cb:toCoreExpression "\"mfr_contact_phone\"" ;
    cb:usesColumn bobsuncle:column_brand__mfr_contact_phone .

bobsuncle:Manufacturer__supportEmail
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Manufacturer ;
    cb:bindsProperty cc:supportEmail ;
    cb:sourceColumn bobsuncle:column_brand__mfr_contact_email ;
    cb:sourceExpression "mfr_contact_email" ;
    cb:valueFormat cb:Email ;
    cb:toCoreExpression "lower(trim(\"mfr_contact_email\"))" ;
    cb:usesColumn bobsuncle:column_brand__mfr_contact_email .

bobsuncle:Manufacturer__websiteUrl
    a owl:NamedIndividual , cb:AttributeBinding ;
    cb:ofConceptBinding bobsuncle:Manufacturer ;
    cb:bindsProperty cc:websiteUrl ;
    cb:sourceColumn bobsuncle:column_brand__mfr_website_url ;
    cb:sourceExpression "mfr_website_url" ;
    cb:valueFormat cb:Text ;
    cb:toCoreExpression "\"mfr_website_url\"" ;
    cb:usesColumn bobsuncle:column_brand__mfr_website_url .

bobsuncle:Manufacturer__headquartersCountry
    a owl:NamedIndividual , cb:RelationBinding ;
    cb:ofConceptBinding bobsuncle:Manufacturer ;
    cb:bindsProperty cc:headquartersCountry ;
