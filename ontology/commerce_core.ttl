cc:marketplaceProductId
    a owl:DatatypeProperty ;
    rdfs:label "marketplace product id"@en ;
    skos:definition "Marketplace catalog number, e.g. a BigRiver number."@en ;
    rdfs:domain cc:Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cc:identifier .

cc:productName
    a owl:DatatypeProperty ;
    rdfs:label "product name"@en ;
    skos:definition "Short name for search results and carts."@en ;
    rdfs:domain cc:Product ;
    rdfs:range xsd:string .

cc:productLongName
    a owl:DatatypeProperty ;
    rdfs:label "product long name"@en ;
    skos:definition "Title for the detail page."@en ;
    rdfs:domain cc:Product ;
    rdfs:range xsd:string .

cc:productDescription
    a owl:DatatypeProperty ;
    rdfs:label "product description"@en ;
    rdfs:domain cc:Product ;
    rdfs:range xsd:string .

cc:weightInGrams
    a owl:DatatypeProperty ;
    rdfs:label "weight in grams"@en ;
    rdfs:domain cc:Product ;
    rdfs:range xsd:integer ;
    cc:valueConvention "Grams."@en .

cc:msrp
    a owl:DatatypeProperty ;
    rdfs:label "MSRP"@en ;
