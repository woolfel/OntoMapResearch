    rdfs:range xsd:string .

cc:attributeValue
    a owl:DatatypeProperty ;
    rdfs:label "attribute value"@en ;
    rdfs:domain cc:ProductAttribute ;
    rdfs:range xsd:string .

cc:confidence
    a owl:DatatypeProperty ;
    rdfs:label "confidence"@en ;
