@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix cc: <https://ontoresearch.example/commerce/core#> .


<https://ontoresearch.example/commerce/core>
    a owl:Ontology ;
    owl:versionIRI <https://ontoresearch.example/commerce/core/1.0.0> ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "Commerce core ontology"@en ;
    dcterms:description "Store-independent concepts of online and in-store commerce: catalog, sellers, offers, inventory, customers, orders and carts, promotions, payments, shipments and returns. It has no knowledge of any database; commerce_binding.ttl maps these concepts to the tables and columns of specific stores."@en ;
    rdfs:comment "* money       xsd:decimal in MAJOR currency units (19.99), with the\n                currency given by cc:hasCurrency on the same resource\n  * percentages xsd:decimal fraction 0..1 (0.15 = 15%)\n  * timestamps  xsd:dateTime in UTC\n  * dates       xsd:date\n  * weight      grams (property names carry the unit)\n  * flags       xsd:boolean\n  * codes       individuals of a code-list class; skos:notation holds\n                the canonical code (e.g. 'PLACED')"@en .


# ---- annotation properties ----

cc:valueConvention
    a owl:AnnotationProperty ;
    rdfs:label "value convention"@en ;
    skos:definition "The unit or representation every value of this property uses, whatever the source. Bindings convert into it."@en .


# ---- classes ----

cc:Country
    a owl:Class ;
    rdfs:label "Country"@en ;
    skos:definition "A country, identified by its ISO 3166-1 alpha-2 code."@en ;
    owl:hasKey ( cc:countryCode ) .

cc:Currency
    a owl:Class ;
    rdfs:label "Currency"@en ;
    skos:definition "A currency, identified by its ISO 4217 code."@en ;
    skos:altLabel "CCY"@en ;
    owl:hasKey ( cc:currencyCode ) .

cc:Category
    a owl:Class ;
    rdfs:label "Category"@en ;
    skos:definition "A node in the merchandising hierarchy used to browse and group products (Garden > Watering & Irrigation)."@en ;
    skos:altLabel "CatalogCategory"@en ;
    skos:altLabel "department"@en ;
    skos:altLabel "dept"@en ;
    skos:altLabel "browse path"@en .

cc:Manufacturer
    a owl:Class ;
    rdfs:label "Manufacturer"@en ;
    skos:definition "The legal company that makes products and stands behind their manufacturer warranty."@en ;
    skos:altLabel "mfr"@en ;
    skos:altLabel "maker"@en .

cc:Brand
    a owl:Class ;
    rdfs:label "Brand"@en ;
    skos:definition "The consumer-facing name a product is sold under. A manufacturer can own several brands."@en ;
    skos:altLabel "brand text"@en ;
    skos:altLabel "make"@en .

cc:ProductModel
    a owl:Class ;
    rdfs:label "Product model"@en ;
    skos:definition "A manufacturer's model: the design identified by a model or part number. Several sellable products (color or pack-size variants) can share one model."@en ;
    skos:altLabel "model"@en ;
    skos:altLabel "part number"@en ;
    skos:altLabel "mfr part no"@en .

cc:Product
    a owl:Class ;
    rdfs:label "Product"@en ;
    skos:definition "A sellable item (one SKU). Seller-independent: what a specific seller charges for it is an Offer."@en ;
    skos:altLabel "Model (AcmeShopping)"@en ;
    skos:altLabel "SKU"@en ;
    skos:altLabel "listing"@en .

cc:ProductAttribute
    a owl:Class ;
    rdfs:label "Product attribute"@en ;
    skos:definition "A named characteristic of a product that is not a fixed property, e.g. color=black or screen_size=65 in."@en ;
    skos:altLabel "tag"@en ;
    skos:altLabel "product tag"@en ;
    skos:altLabel "EAV attribute"@en .

cc:WarrantyPlan
    a owl:Class ;
    rdfs:label "Warranty plan"@en ;
    skos:definition "Terms under which a product is repaired or replaced, either included by the manufacturer or sold as an extended plan."@en ;
    skos:altLabel "warranty"@en ;
    skos:altLabel "protection plan"@en .

cc:Seller
    a owl:Class ;
    rdfs:label "Seller"@en ;
    skos:definition "A party that sells products: the platform itself (first party) or a third-party store on a marketplace."@en ;
    skos:altLabel "store"@en ;
    skos:altLabel "merchant"@en ;
    skos:altLabel "vendor"@en .

cc:Offer
    a owl:Class ;
    rdfs:label "Offer"@en ;
    skos:definition "A seller's price for a product, in a currency, for a period of time."@en ;
    skos:altLabel "listing price"@en ;
    skos:altLabel "retail price"@en ;
    skos:altLabel "offer price"@en .

cc:Warehouse
    a owl:Class ;
    rdfs:label "Warehouse"@en ;
    skos:definition "A location that holds stock: a distribution center or a store."@en ;
    skos:altLabel "whse"@en ;
    skos:altLabel "location"@en ;
    skos:altLabel "fulfillment center"@en .

cc:InventoryPosition
    a owl:Class ;
    rdfs:label "Inventory position"@en ;
    skos:definition "How much of one product is held at one warehouse."@en ;
    skos:altLabel "inventory"@en ;
    skos:altLabel "stock level"@en .

cc:Customer
    a owl:Class ;
    rdfs:label "Customer"@en ;
    skos:definition "A registered shopper with an account and profile."@en ;
    skos:altLabel "account"@en ;
    skos:altLabel "cust_ref"@en ;
    skos:altLabel "shopper"@en .

cc:Address
    a owl:Class ;
    rdfs:label "Address"@en ;
    skos:definition "A postal address. Sources often hold only part of it, e.g. a postal code or region."@en ;
    skos:altLabel "ship to"@en ;
    skos:altLabel "ship zip"@en ;
    skos:altLabel "ship region"@en .

cc:Order
    a owl:Class ;
    rdfs:label "Order"@en ;
    skos:definition "A purchase from start to finish. A cart is an order that has not been placed yet; the order status says where it is in its life."@en ;
    skos:altLabel "cart"@en ;
    skos:altLabel "shopping cart"@en ;
    skos:altLabel "basket"@en ;
    skos:altLabel "checkout"@en .

cc:OrderLine
    a owl:Class ;
    rdfs:label "Order line"@en ;
    skos:definition "One product, from one seller, in an order or cart."@en ;
    skos:altLabel "order item"@en ;
    skos:altLabel "cart item"@en ;
    skos:altLabel "line item"@en ;
    skos:altLabel "ITEM"@en .

cc:Promotion
    a owl:Class ;
    rdfs:label "Promotion"@en ;
    skos:definition "A rule that reduces price: a coupon code, an automatic deal or an event sale."@en ;
    skos:altLabel "promo"@en ;
    skos:altLabel "coupon"@en ;
    skos:altLabel "deal"@en ;
    skos:altLabel "discount rule"@en .

cc:AppliedDiscount
    a owl:Class ;
    rdfs:label "Applied discount"@en ;
    skos:definition "A discount actually granted on an order or order line, with or without a promotion behind it."@en ;
    skos:altLabel "discount"@en ;
    skos:altLabel "savings"@en ;
    skos:altLabel "disc"@en .

cc:Payment
    a owl:Class ;
    rdfs:label "Payment"@en ;
    skos:definition "Money collected for an order."@en ;
    skos:altLabel "tender"@en ;
    skos:altLabel "charge"@en .

cc:Shipment
    a owl:Class ;
    rdfs:label "Shipment"@en ;
    skos:definition "A package sent for an order from one seller or warehouse."@en ;
    skos:altLabel "parcel"@en ;
    skos:altLabel "package"@en ;
    skos:altLabel "fulfillment"@en .

cc:ShipmentLine
    a owl:Class ;
    rdfs:label "Shipment line"@en ;
    skos:definition "How many units of an order line a shipment holds."@en .

cc:ReturnAuthorization
    a owl:Class ;
    rdfs:label "Return authorization"@en ;
    skos:definition "Approval for a customer to send items back (RMA)."@en ;
    skos:altLabel "RMA"@en ;
    skos:altLabel "return"@en .

cc:ReturnLine
    a owl:Class ;
    rdfs:label "Return line"@en ;
    skos:definition "Units of one product coming back under a return."@en ;
    skos:altLabel "return item"@en ;
    skos:altLabel "negative quantity line"@en .

cc:Refund
    a owl:Class ;
    rdfs:label "Refund"@en ;
    skos:definition "Money paid back to a customer."@en .

cc:CodeList
    a owl:Class ;
    rdfs:label "Code list"@en ;
    skos:definition "Superclass of all controlled vocabularies. Each member has a skos:notation holding its canonical code."@en .

cc:OrderStatus
    a owl:Class ;
    rdfs:label "Order status"@en ;
    skos:definition "Where an order is in its life."@en ;
    skos:altLabel "cart state"@en ;
    skos:altLabel "cart_stat"@en ;
    rdfs:subClassOf cc:CodeList .

cc:SalesChannel
    a owl:Class ;
    rdfs:label "Sales channel"@en ;
    skos:definition "How the order was placed."@en ;
    skos:altLabel "channel"@en ;
    rdfs:subClassOf cc:CodeList .

cc:DeviceType
    a owl:Class ;
    rdfs:label "Device type"@en ;
    skos:definition "The device the shopper used."@en ;
    skos:altLabel "device"@en ;
    rdfs:subClassOf cc:CodeList .

cc:SellerStatus
    a owl:Class ;
    rdfs:label "Seller status"@en ;
    skos:definition "Whether a seller may sell."@en ;
    rdfs:subClassOf cc:CodeList .

cc:ItemCondition
    a owl:Class ;
    rdfs:label "Item condition"@en ;
    skos:definition "Condition of the item being offered."@en ;
    rdfs:subClassOf cc:CodeList .

cc:PromotionScope
    a owl:Class ;
    rdfs:label "Promotion scope"@en ;
    skos:definition "The level a promotion discounts at."@en ;
    skos:altLabel "promotion type"@en ;
    rdfs:subClassOf cc:CodeList .

cc:FundingSource
    a owl:Class ;
    rdfs:label "Funding source"@en ;
    skos:definition "Who pays for a promotion."@en ;
    skos:altLabel "funded by"@en ;
    rdfs:subClassOf cc:CodeList .

cc:AttributeSource
    a owl:Class ;
    rdfs:label "Attribute source"@en ;
    skos:definition "Who supplied a product attribute."@en ;
    skos:altLabel "tag source"@en ;
    rdfs:subClassOf cc:CodeList .

cc:WarrantyType
    a owl:Class ;
    rdfs:label "Warranty type"@en ;
    skos:definition "Kind of warranty."@en ;
    rdfs:subClassOf cc:CodeList .

cc:CustomerStatus
    a owl:Class ;
    rdfs:label "Customer status"@en ;
    skos:definition "Whether a customer account is usable."@en ;
    rdfs:subClassOf cc:CodeList .

cc:PaymentMethod
    a owl:Class ;
    rdfs:label "Payment method"@en ;
    skos:definition "How a payment was made."@en ;
    skos:altLabel "tender type"@en ;
    rdfs:subClassOf cc:CodeList .

cc:PaymentStatus
    a owl:Class ;
    rdfs:label "Payment status"@en ;
    skos:definition "Where a payment is in its life."@en ;
    rdfs:subClassOf cc:CodeList .

cc:ShipmentStatus
    a owl:Class ;
    rdfs:label "Shipment status"@en ;
    skos:definition "Where a shipment is in its life."@en ;
    rdfs:subClassOf cc:CodeList .

cc:ReturnStatus
    a owl:Class ;
    rdfs:label "Return status"@en ;
    skos:definition "Where a return authorization is in its life."@en ;
    skos:altLabel "RMA status"@en ;
    rdfs:subClassOf cc:CodeList .

cc:ReturnReason
    a owl:Class ;
    rdfs:label "Return reason"@en ;
    skos:definition "Why items came back."@en ;
    rdfs:subClassOf cc:CodeList .

cc:ReturnResolution
    a owl:Class ;
    rdfs:label "Return resolution"@en ;
    skos:definition "What the customer gets for a return."@en ;
    rdfs:subClassOf cc:CodeList .

cc:ReturnedCondition
    a owl:Class ;
    rdfs:label "Returned condition"@en ;
    skos:definition "Condition a returned item arrived in."@en ;
    rdfs:subClassOf cc:CodeList .

cc:Disposition
    a owl:Class ;
    rdfs:label "Disposition"@en ;
    skos:definition "What happens to a returned item."@en ;
    rdfs:subClassOf cc:CodeList .

cc:RefundStatus
    a owl:Class ;
    rdfs:label "Refund status"@en ;
    skos:definition "Where a refund is in its life."@en ;
    rdfs:subClassOf cc:CodeList .

[] a owl:AllDisjointClasses ;
    owl:members ( cc:Category cc:Manufacturer cc:Brand cc:ProductModel cc:Product cc:ProductAttribute cc:WarrantyPlan cc:Seller cc:Offer cc:Warehouse cc:InventoryPosition cc:Customer cc:Address cc:Order cc:OrderLine cc:Promotion cc:AppliedDiscount cc:Payment cc:Shipment cc:ShipmentLine cc:ReturnAuthorization cc:ReturnLine cc:Refund cc:Country cc:Currency cc:CodeList ) .


# ---- defined classes (classify orders by status) ----

cc:Cart
    a owl:Class ;
    rdfs:label "Cart"@en ;
    skos:definition "An order that has not been placed (still shopping, saved, abandoned or expired)."@en ;
    rdfs:subClassOf cc:Order ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( cc:Order [ a owl:Restriction ; owl:onProperty cc:orderStatus ; owl:someValuesFrom [ a owl:Class ; owl:oneOf ( cc:OrderStatus_CART cc:OrderStatus_SAVED_FOR_LATER cc:OrderStatus_ABANDONED cc:OrderStatus_EXPIRED ) ] ] ) ] .

cc:PlacedOrder
    a owl:Class ;
    rdfs:label "Placed order"@en ;
    skos:definition "An order the customer has checked out."@en ;
    rdfs:subClassOf cc:Order ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( cc:Order [ a owl:Restriction ; owl:onProperty cc:orderStatus ; owl:someValuesFrom [ a owl:Class ; owl:oneOf ( cc:OrderStatus_PLACED cc:OrderStatus_PAID cc:OrderStatus_PARTIALLY_SHIPPED cc:OrderStatus_SHIPPED cc:OrderStatus_DELIVERED cc:OrderStatus_PARTIALLY_RETURNED cc:OrderStatus_RETURNED ) ] ] ) ] .


# ---- object properties ----

cc:hasCurrency
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has currency"@en ;
    skos:definition "Currency of the monetary amounts on this resource."@en ;
    rdfs:range cc:Currency .

cc:countryOfOrigin
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "country of origin"@en ;
    skos:definition "Where the product or brand comes from."@en ;
    rdfs:range cc:Country .

cc:parentCategory
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "parent category"@en ;
    skos:definition "The broader category this one sits under."@en ;
    rdfs:domain cc:Category ;
    rdfs:range cc:Category .

cc:ownedBy
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "owned by"@en ;
    skos:definition "The manufacturer that owns the brand."@en ;
    rdfs:domain cc:Brand ;
    rdfs:range cc:Manufacturer .

cc:headquartersCountry
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "headquarters country"@en ;
    rdfs:domain cc:Manufacturer ;
    rdfs:range cc:Country .

cc:ofBrand
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "of brand"@en ;
    skos:definition "Brand the model is sold under."@en ;
    rdfs:domain cc:ProductModel ;
    rdfs:range cc:Brand .

cc:hasModel
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has model"@en ;
    skos:definition "Manufacturer model of the product."@en ;
    rdfs:domain cc:Product ;
    rdfs:range cc:ProductModel .

cc:hasBrand
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "has brand"@en ;
    skos:definition "Brand of the product. Usually the brand of its model; stated directly when the model is unknown."@en ;
    rdfs:domain cc:Product ;
    rdfs:range cc:Brand .

cc:inCategory
    a owl:ObjectProperty ;
    rdfs:label "in category"@en ;
    skos:definition "Merchandising category."@en ;
    rdfs:domain cc:Product ;
    rdfs:range cc:Category .

cc:hasAttribute
    a owl:ObjectProperty ;
    rdfs:label "has attribute"@en ;
    rdfs:domain cc:Product ;
    rdfs:range cc:ProductAttribute ;
    owl:inverseOf cc:attributeOf .

cc:attributeOf
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "attribute of"@en ;
    rdfs:domain cc:ProductAttribute ;
    rdfs:range cc:Product ;
    owl:inverseOf cc:hasAttribute .

cc:attributeSource
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "attribute source"@en ;
    rdfs:domain cc:ProductAttribute ;
    rdfs:range cc:AttributeSource .

cc:hasWarranty
    a owl:ObjectProperty ;
    rdfs:label "has warranty"@en ;
    rdfs:domain cc:Product ;
    rdfs:range cc:WarrantyPlan .

cc:warrantyType
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "warranty type"@en ;
    rdfs:domain cc:WarrantyPlan ;
    rdfs:range cc:WarrantyType .

cc:warrantyProduct
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "warranty product"@en ;
    skos:definition "The product sold to buy this plan, for extended warranties."@en ;
    rdfs:domain cc:WarrantyPlan ;
    rdfs:range cc:Product .

cc:sellerCountry
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "seller country"@en ;
    rdfs:domain cc:Seller ;
    rdfs:range cc:Country .

cc:defaultCurrency
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "default currency"@en ;
    rdfs:domain cc:Seller ;
    rdfs:range cc:Currency .

cc:sellerStatus
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "seller status"@en ;
    rdfs:domain cc:Seller ;
    rdfs:range cc:SellerStatus .

cc:offeredBy
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "offered by"@en ;
    rdfs:domain cc:Offer ;
    rdfs:range cc:Seller .

cc:offerFor
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "offer for"@en ;
    rdfs:domain cc:Offer ;
    rdfs:range cc:Product .

cc:itemCondition
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "item condition"@en ;
    rdfs:domain cc:Offer ;
    rdfs:range cc:ItemCondition .

cc:operatedBy
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "operated by"@en ;
    rdfs:domain cc:Warehouse ;
    rdfs:range cc:Seller .

cc:hasAddress
    a owl:ObjectProperty ;
    rdfs:label "has address"@en ;
    skos:definition "A postal address of the resource."@en ;
    rdfs:range cc:Address .

cc:stockOf
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "stock of"@en ;
    rdfs:domain cc:InventoryPosition ;
    rdfs:range cc:Product .

cc:heldAt
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "held at"@en ;
    rdfs:domain cc:InventoryPosition ;
    rdfs:range cc:Warehouse .

cc:addressCountry
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "address country"@en ;
    rdfs:domain cc:Address ;
    rdfs:range cc:Country .

cc:preferredCurrency
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "preferred currency"@en ;
    rdfs:domain cc:Customer ;
    rdfs:range cc:Currency .

cc:customerStatus
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "customer status"@en ;
    rdfs:domain cc:Customer ;
    rdfs:range cc:CustomerStatus .

cc:defaultBillingAddress
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "default billing address"@en ;
    rdfs:domain cc:Customer ;
    rdfs:range cc:Address .

cc:defaultShippingAddress
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "default shipping address"@en ;
    rdfs:domain cc:Customer ;
    rdfs:range cc:Address .

cc:placedBy
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "placed by"@en ;
    skos:definition "Registered customer; absent for guests."@en ;
    rdfs:domain cc:Order ;
    rdfs:range cc:Customer .

cc:orderStatus
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "order status"@en ;
    rdfs:domain cc:Order ;
    rdfs:range cc:OrderStatus .

cc:salesChannel
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sales channel"@en ;
    rdfs:domain cc:Order ;
    rdfs:range cc:SalesChannel .

cc:deviceType
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "device type"@en ;
    rdfs:domain cc:Order ;
    rdfs:range cc:DeviceType .

cc:billingAddress
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "billing address"@en ;
    skos:definition "Address used for billing (order or payment)."@en ;
    rdfs:range cc:Address .

cc:shippingAddress
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "shipping address"@en ;
    skos:definition "Where the order ships. May be partial, e.g. postal code only."@en ;
    rdfs:domain cc:Order ;
    rdfs:range cc:Address .

cc:hasLine
    a owl:ObjectProperty ;
    rdfs:label "has line"@en ;
    rdfs:domain cc:Order ;
    rdfs:range cc:OrderLine ;
    owl:inverseOf cc:lineOf .

cc:lineOf
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "line of"@en ;
    rdfs:domain cc:OrderLine ;
    rdfs:range cc:Order ;
    owl:inverseOf cc:hasLine .

cc:ofProduct
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "of product"@en ;
    rdfs:domain cc:OrderLine ;
    rdfs:range cc:Product .

cc:soldBy
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "sold by"@en ;
    rdfs:domain cc:OrderLine ;
    rdfs:range cc:Seller .

cc:fromOffer
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "from offer"@en ;
    rdfs:domain cc:OrderLine ;
    rdfs:range cc:Offer .

cc:fulfilledFrom
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "fulfilled from"@en ;
    rdfs:domain cc:OrderLine ;
    rdfs:range cc:Warehouse .

cc:addOnFor
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "add-on for"@en ;
    skos:definition "The line this add-on (e.g. a protection plan) was sold with."@en ;
    rdfs:domain cc:OrderLine ;
    rdfs:range cc:OrderLine .

cc:originalCurrency
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "original currency"@en ;
    skos:definition "Seller's currency when it differs from the order currency."@en ;
    rdfs:domain cc:OrderLine ;
    rdfs:range cc:Currency .

cc:promotionScope
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "promotion scope"@en ;
    rdfs:domain cc:Promotion ;
    rdfs:range cc:PromotionScope .

cc:fundedBy
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "funded by"@en ;
    rdfs:domain cc:Promotion ;
    rdfs:range cc:FundingSource .

cc:fundingSeller
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "funding seller"@en ;
    skos:definition "Seller paying for the promotion."@en ;
    rdfs:domain cc:Promotion ;
    rdfs:range cc:Seller .

cc:fundingBrand
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "funding brand"@en ;
    skos:definition "Brand whose manufacturer pays."@en ;
    rdfs:domain cc:Promotion ;
    rdfs:range cc:Brand .

cc:appliesToProduct
    a owl:ObjectProperty ;
    rdfs:label "applies to product"@en ;
    rdfs:domain cc:Promotion ;
    rdfs:range cc:Product .

cc:appliesToModel
    a owl:ObjectProperty ;
