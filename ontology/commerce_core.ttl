# ---- code lists ----

cc:OrderStatus owl:equivalentClass [ a owl:Class ; owl:oneOf ( cc:OrderStatus_CART cc:OrderStatus_SAVED_FOR_LATER cc:OrderStatus_ABANDONED cc:OrderStatus_EXPIRED cc:OrderStatus_PLACED cc:OrderStatus_PAID cc:OrderStatus_PARTIALLY_SHIPPED cc:OrderStatus_SHIPPED cc:OrderStatus_DELIVERED cc:OrderStatus_CANCELLED cc:OrderStatus_PARTIALLY_RETURNED cc:OrderStatus_RETURNED ) ] .

[] a owl:AllDifferent ;
    owl:distinctMembers ( cc:OrderStatus_CART cc:OrderStatus_SAVED_FOR_LATER cc:OrderStatus_ABANDONED cc:OrderStatus_EXPIRED cc:OrderStatus_PLACED cc:OrderStatus_PAID cc:OrderStatus_PARTIALLY_SHIPPED cc:OrderStatus_SHIPPED cc:OrderStatus_DELIVERED cc:OrderStatus_CANCELLED cc:OrderStatus_PARTIALLY_RETURNED cc:OrderStatus_RETURNED ) .

cc:OrderStatus_CART
    a owl:NamedIndividual , cc:OrderStatus ;
    rdfs:label "Cart"@en ;
    skos:notation "CART" ;
    skos:definition "Shopper is still adding items."@en .

cc:OrderStatus_SAVED_FOR_LATER
    a owl:NamedIndividual , cc:OrderStatus ;
    rdfs:label "Saved for later"@en ;
    skos:notation "SAVED_FOR_LATER" ;
    skos:definition "Shopper parked the cart."@en .

cc:OrderStatus_ABANDONED
    a owl:NamedIndividual , cc:OrderStatus ;
    rdfs:label "Abandoned"@en ;
    skos:notation "ABANDONED" ;
    skos:definition "Shopper left without buying."@en .

cc:OrderStatus_EXPIRED
    a owl:NamedIndividual , cc:OrderStatus ;
    rdfs:label "Expired"@en ;
    skos:notation "EXPIRED" ;
    skos:definition "Cart timed out without being bought."@en .

cc:OrderStatus_PLACED
    a owl:NamedIndividual , cc:OrderStatus ;
    rdfs:label "Placed"@en ;
    skos:notation "PLACED" ;
    skos:definition "Checked out, not yet paid or shipped."@en .

cc:OrderStatus_PAID
    a owl:NamedIndividual , cc:OrderStatus ;
    rdfs:label "Paid"@en ;
    skos:notation "PAID" ;
    skos:definition "Payment captured."@en .

cc:OrderStatus_PARTIALLY_SHIPPED
    a owl:NamedIndividual , cc:OrderStatus ;
    rdfs:label "Partially shipped"@en ;
    skos:notation "PARTIALLY_SHIPPED" ;
    skos:definition "Some lines have shipped."@en .

cc:OrderStatus_SHIPPED
    a owl:NamedIndividual , cc:OrderStatus ;
    rdfs:label "Shipped"@en ;
    skos:notation "SHIPPED" ;
    skos:definition "All lines have shipped."@en .

cc:OrderStatus_DELIVERED
    a owl:NamedIndividual , cc:OrderStatus ;
    rdfs:label "Delivered"@en ;
    skos:notation "DELIVERED" ;
    skos:definition "Delivered to the customer."@en .

cc:OrderStatus_CANCELLED
    a owl:NamedIndividual , cc:OrderStatus ;
    rdfs:label "Cancelled"@en ;
    skos:notation "CANCELLED" ;
    skos:definition "Cancelled before fulfilment."@en .

cc:OrderStatus_PARTIALLY_RETURNED
    a owl:NamedIndividual , cc:OrderStatus ;
    rdfs:label "Partially returned"@en ;
    skos:notation "PARTIALLY_RETURNED" ;
    skos:definition "Some units came back."@en .

cc:OrderStatus_RETURNED
    a owl:NamedIndividual , cc:OrderStatus ;
    rdfs:label "Returned"@en ;
    skos:notation "RETURNED" ;
    skos:definition "Everything came back."@en .

cc:SalesChannel owl:equivalentClass [ a owl:Class ; owl:oneOf ( cc:SalesChannel_WEB cc:SalesChannel_APP cc:SalesChannel_POS cc:SalesChannel_VOICE ) ] .

[] a owl:AllDifferent ;
    owl:distinctMembers ( cc:SalesChannel_WEB cc:SalesChannel_APP cc:SalesChannel_POS cc:SalesChannel_VOICE ) .

cc:SalesChannel_WEB
    a owl:NamedIndividual , cc:SalesChannel ;
