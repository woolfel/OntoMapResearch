# ---- datatype properties ----

cc:isActive
    a owl:DatatypeProperty ;
    rdfs:label "is active"@en ;
    skos:definition "Whether the resource is currently in use."@en ;
    rdfs:range xsd:boolean .

cc:createdAt
    a owl:DatatypeProperty ;
    rdfs:label "created at"@en ;
    skos:definition "When the source created the record."@en ;
    rdfs:range xsd:dateTime ;
    cc:valueConvention "UTC."@en .

cc:updatedAt
    a owl:DatatypeProperty ;
    rdfs:label "updated at"@en ;
    skos:definition "When the source last changed the record."@en ;
    rdfs:range xsd:dateTime ;
    cc:valueConvention "UTC."@en .

cc:effectiveFrom
    a owl:DatatypeProperty ;
    rdfs:label "effective from"@en ;
    skos:definition "Start of validity."@en ;
    rdfs:range xsd:dateTime ;
    cc:valueConvention "UTC."@en .

cc:effectiveUntil
    a owl:DatatypeProperty ;
    rdfs:label "effective until"@en ;
    skos:definition "End of validity; absent = open-ended."@en ;
    rdfs:range xsd:dateTime ;
    cc:valueConvention "UTC."@en .

cc:websiteUrl
    a owl:DatatypeProperty ;
    rdfs:label "website URL"@en ;
    rdfs:range xsd:anyURI .

cc:phone
    a owl:DatatypeProperty ;
    rdfs:label "phone"@en ;
    rdfs:range xsd:string .

cc:email
    a owl:DatatypeProperty ;
    rdfs:label "email"@en ;
    skos:definition "Lower-case email address."@en ;
    rdfs:range xsd:string .

cc:quantity
    a owl:DatatypeProperty ;
    rdfs:label "quantity"@en ;
    skos:definition "Number of units; always positive."@en ;
    rdfs:range xsd:integer .

cc:monetaryAmount
    a owl:DatatypeProperty ;
    rdfs:label "monetary amount"@en ;
    skos:definition "Super-property of every money value."@en ;
    rdfs:range xsd:decimal ;
    cc:valueConvention "Major currency units of cc:hasCurrency (19.99)."@en .

cc:identifier
    a owl:DatatypeProperty ;
    rdfs:label "identifier"@en ;
    skos:definition "Super-property of every business identifier."@en ;
    rdfs:range xsd:string .

cc:countryCode
    a owl:DatatypeProperty ;
    rdfs:label "country code"@en ;
    skos:definition "ISO 3166-1 alpha-2."@en ;
    rdfs:domain cc:Country ;
    rdfs:range xsd:string .

cc:countryName
    a owl:DatatypeProperty ;
    rdfs:label "country name"@en ;
    rdfs:domain cc:Country ;
    rdfs:range xsd:string .

cc:currencyCode
    a owl:DatatypeProperty ;
    rdfs:label "currency code"@en ;
    skos:definition "ISO 4217."@en ;
    rdfs:domain cc:Currency ;
    rdfs:range xsd:string .

cc:currencyName
    a owl:DatatypeProperty ;
    rdfs:label "currency name"@en ;
    rdfs:domain cc:Currency ;
    rdfs:range xsd:string .

cc:minorUnitDigits
    a owl:DatatypeProperty ;
    rdfs:label "minor unit digits"@en ;
    skos:definition "Digits after the decimal point (2 for USD, 0 for JPY)."@en ;
    rdfs:domain cc:Currency ;
    rdfs:range xsd:integer .

cc:categoryCode
    a owl:DatatypeProperty ;
    rdfs:label "category code"@en ;
    skos:definition "Stable code or full browse path."@en ;
    rdfs:domain cc:Category ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cc:identifier .

cc:categoryName
    a owl:DatatypeProperty ;
    rdfs:label "category name"@en ;
    rdfs:domain cc:Category ;
    rdfs:range xsd:string .

cc:categoryDescription
    a owl:DatatypeProperty ;
    rdfs:label "category description"@en ;
    rdfs:domain cc:Category ;
    rdfs:range xsd:string .

cc:sortOrder
    a owl:DatatypeProperty ;
    rdfs:label "sort order"@en ;
    rdfs:domain cc:Category ;
    rdfs:range xsd:integer .

cc:manufacturerName
    a owl:DatatypeProperty ;
    rdfs:label "manufacturer name"@en ;
    skos:definition "Legal company name."@en ;
    rdfs:domain cc:Manufacturer ;
    rdfs:range xsd:string .

cc:manufacturerCode
    a owl:DatatypeProperty ;
    rdfs:label "manufacturer code"@en ;
    skos:definition "Short code, e.g. SNY."@en ;
    rdfs:domain cc:Manufacturer ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cc:identifier .

cc:supportEmail
    a owl:DatatypeProperty ;
    rdfs:label "support email"@en ;
    skos:definition "Warranty inquiries."@en ;
    rdfs:domain cc:Manufacturer ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cc:email .

cc:brandName
    a owl:DatatypeProperty ;
    rdfs:label "brand name"@en ;
    rdfs:domain cc:Brand ;
    rdfs:range xsd:string .

cc:modelNumber
    a owl:DatatypeProperty ;
    rdfs:label "model number"@en ;
    skos:definition "Manufacturer's model or part number."@en ;
    rdfs:domain cc:ProductModel ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cc:identifier .

cc:modelName
    a owl:DatatypeProperty ;
    rdfs:label "model name"@en ;
    rdfs:domain cc:ProductModel ;
    rdfs:range xsd:string .

cc:modelYear
    a owl:DatatypeProperty ;
    rdfs:label "model year"@en ;
    rdfs:domain cc:ProductModel ;
    rdfs:range xsd:integer .

cc:releaseDate
    a owl:DatatypeProperty ;
    rdfs:label "release date"@en ;
    rdfs:domain cc:ProductModel ;
    rdfs:range xsd:date .

cc:discontinuedDate
    a owl:DatatypeProperty ;
    rdfs:label "discontinued date"@en ;
    skos:definition "Absent while still sold."@en ;
    rdfs:domain cc:ProductModel ;
    rdfs:range xsd:date .

cc:sku
    a owl:DatatypeProperty ;
    rdfs:label "SKU"@en ;
    skos:definition "Retailer's stock keeping unit."@en ;
    rdfs:domain cc:Product ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cc:identifier .

cc:upc
    a owl:DatatypeProperty ;
